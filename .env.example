OLLAMA_KEEP_ALIVE=-1
LIVEKIT_API_SECRET=6f1d0c9b7a34e6c2d8f501c9a4b3e2975c4d8f6a1b2c3d4e5f60718293a0b1c0
STT_BACKEND=whisper
# optional tweaks:
WHISPER_MODEL=large-v3-turbo  # faster large v3 variant
WHISPER_DEVICE=cuda          # use GPU for speed
WHISPER_COMPUTE_TYPE=int8_float16    # ~half the VRAM of float16, negligible accuracy loss — leaves room for Ollama on the GPU
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1
WHISPER_TEMPERATURE=0.0
WHISPER_PRE_ROLL_MS=240
USER_FRAGMENT_MERGE_SEC=0.6
PREEMPTIVE_STT=1
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey



# OLLAMA_MODEL=llama3.2:3b-instruct-q4_0
OLLAMA_MODEL=qwen2.5:0.5b 
PIPER_EXE=bin/piper.exe
PIPER_MODEL=models/piper/en_US-danny-low.onnx
PIPER_CONFIG=models/piper/en_US-danny-low.onnx.json
# PIPER_MODEL=models/piper/hi_IN-priyamvada-medium.onnx
# PIPER_CONFIG=models/piper/hi_IN-priyamvada-medium.onnx.json


SILERO_ACTIVATION=0.26    # VAD start threshold; lower = more sensitive, catches very short words/letters
SILERO_DEACTIVATION=0.16  # VAD stop threshold; lower keeps listening through tiny breaths/pauses
SILERO_MIN_SPEECH_MS=50   # Minimum speech chunk length (ms); allows single-letter utterances like “A”
SILERO_MIN_SILENCE_MS=650 # Required silence (ms) to end the turn; raise to hold the mic open longer
SILERO_PREFIX_PAD_MS=900  # Pre-roll pad (ms) prepended so consonant onsets aren’t clipped
SILERO_DEVICE=cpu         # Silero VAD is tiny; CPU is faster than GPU here (no per-chunk GPU round-trip) and frees VRAM for Whisper/Ollama

PIPER_USE_CUDA=0
PIPER_THREADS=6          # or number of physical cores you want to use
PIPER_NOISE_SCALE=0.7
PIPER_LENGTH_SCALE=1.0   # slightly faster speech

# new setting after this///

WHISPER_HPF_HZ=110
WHISPER_TARGET_RMS_DB=-18


CHAT_NUM_PREDICT=200
CHAT_NUM_CTX=2048
CHAT_TEMPERATURE=0.1

